* text=auto eol=lf
*.png binary

# The seal's files are generated by `python -m vault make`, and diffs of them are noise.
# (They also keep GitHub's language bar honest: a file named ROOT is not an Isabelle theory.)
sealed/** linguist-generated=true -diff
interfaces/INDEX.md linguist-generated=true
examples/proofs/** linguist-generated=true

# The site's contracts are TypeScript declarations: count them as the TypeScript they are.
interfaces/observatory/** linguist-language=TypeScript linguist-detectable=true linguist-generated=false linguist-vendored=false

# examples/ holds working code - the verifiers in Python, JavaScript and the browser - not documentation.
examples/** linguist-documentation=false
